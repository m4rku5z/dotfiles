{{- $is_mac := eq .chezmoi.os "darwin" -}}
{{- $is_wsl := and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{- $machine_type := promptChoiceOnce . "machine_type" "Machine type" (list "work" "personal") -}}
data:
  is_mac: {{ $is_mac }}
  is_wsl: {{ $is_wsl }}
  machine_type: {{ $machine_type | quote }}

diff:
  pager: delta
